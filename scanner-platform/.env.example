# Copy to .env and fill in. Never commit .env.

# Tailscale IP of this host (`tailscale ip -4`). Caddy binds ONLY to this address.
# For local lab testing without Tailscale you may use 127.0.0.1.
TAILSCALE_IP=100.64.0.10

# Hostname staff use to reach the UI over the tailnet (MagicDNS name or the Tailscale IP).
SITE_HOST=scanner.your-tailnet.ts.net

# Postgres (app database)
POSTGRES_USER=scanner
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=scanner

# Valkey
VALKEY_PASSWORD=change-me-long-random

# Session/CSRF secret: `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-at-least-32-characters-long

# Login session lifetime in seconds (absolute, default 8 hours)
SESSION_TTL_SECONDS=28800

# Timezone for times shown and entered in the UI (stored as UTC)
TIMEZONE=Australia/Sydney

# Extra CIDRs that must never be scanned, comma separated, on top of the built-in
# blocklist (private, loopback, link-local, CGNAT, metadata, ...). Add your own ranges.
BLOCKLIST_EXTRA=
